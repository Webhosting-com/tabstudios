<!-- SERVICES -->
<section id="services">
  <div class="container">
    <div class="section-label reveal">What We Offer</div>
    <h2 class="reveal">Our <em>Services</em></h2>
    <p class="body-text reveal">Everything you need to go from idea to finished, industry-ready release — all under one roof.</p>

    <div class="services-grid">

      <div class="service-card reveal">
        <div class="service-icon">🎙️</div>
        <h3>Studio Time</h3>
        <p>Record in a professional environment with a qualified engineer by your side the whole session.</p>
        <ul class="service-list">
          <li>Professional recording engineer included</li>
          <li>Neumann & Shure microphone options</li>
          <li>Apollo interfaces for crystal clarity</li>
          <li>Access to premium plugins</li>
          <li>Recorded in Logic Pro X</li>
          <li>High-quality acoustic environment</li>
        </ul>
      </div>

      <div class="service-card reveal">
        <div class="service-icon">🎚️</div>
        <h3>Mixing & Mastering</h3>
        <p>Transform your raw recordings into a clean, punchy, streaming-ready release that stands up to any major label track.</p>
        <ul class="service-list">
          <li>Industry-quality sound enhancement</li>
          <li>Clean, powerful, streaming-ready mixes</li>
          <li>Balanced low-end and clarity</li>
          <li>Loudness optimised for all platforms</li>
        </ul>
        <div class="service-price">From £150</div>
      </div>

      <div class="service-card reveal">
